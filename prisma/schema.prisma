generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                     String         @id @default(cuid())
  username               String         @unique
  displayName            String
  passwordHash           String
  secretQuestion         String
  secretAnswerHash       String
  role                   Role           @default(USER)
  isActive               Boolean        @default(true)
  recoveryFailedAttempts Int            @default(0)
  recoveryLockedUntil    DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  sessions               Session[]
  progress               TaskProgress[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Cape {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  shortName   String
  description String
  isAvailable Boolean           @default(false)
  sortOrder   Int               @default(0)
  requirements CapeRequirement[]
}

model Task {
  id                String            @id @default(cuid())
  sourceKey         String            @unique
  name              String
  description       String?
  category          String?
  subcategory       String?
  subsubcategory    String?
  releaseDate       String?
  wikiUrl           String?
  compOrder         Int?
  compPriority      String?
  compDifficulty    String?
  compTimeType      String?
  compInstructions  String?
  initialCompleted  Boolean           @default(false)
  requirements      CapeRequirement[]
  progress          TaskProgress[]

  @@index([name])
  @@index([category])
  @@index([subcategory])
}

model CapeRequirement {
  capeId    String
  taskId    String
  sortOrder Int      @default(0)
  cape      Cape     @relation(fields: [capeId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([capeId, taskId])
  @@index([taskId])
}

model TaskProgress {
  userId     String
  taskId     String
  completedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
  @@index([taskId])
}
